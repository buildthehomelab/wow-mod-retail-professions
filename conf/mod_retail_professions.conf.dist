[worldserver]

########################################
# mod-retail-professions
#
# Server half of the retail-style profession window. Players with the RetailProfessions addon
# see every recipe of their professions, including the ones they haven't learned, with exact
# skill-up thresholds and where to learn each one. Crafting itself is unchanged.
########################################

#
#    RetailProfessions.Enable
#        Description: Master switch. With 0 the addon still replaces the profession window, but
#                     without unlearned recipes, thresholds or sources.
#        Default:     1
#

RetailProfessions.Enable = 1

#
#    RetailProfessions.SkillCapByEra
#        Description: With mod-individual-progression (IndividualProgression.Enable = 1), only
#                     list unlearned recipes a player's era allows: up to skill 300 before
#                     Outland opens, 375 before Northrend. Recipes are gated by skill tier,
#                     never by profession.
#        Default:     1
#

RetailProfessions.SkillCapByEra = 1

#
#    RetailProfessions.HideLockedContinents
#        Description: Leave out trainers, vendors and drops on a continent (or in a dungeon of an
#                     expansion) mod-individual-progression hasn't opened for the player yet.
#                     The list then ends with "And 3 more in Outland, once it opens to you".
#        Default:     1
#

RetailProfessions.HideLockedContinents = 1

#
#    RetailProfessions.MaxSourcesPerKind
#        Description: Most trainers, vendors, drops, chests and containers listed for one recipe,
#                     per kind. Trainers and vendors nearest the player come first, drops by
#                     chance. 1-20.
#        Default:     6
#

RetailProfessions.MaxSourcesPerKind = 6

#
#    RetailProfessions.WorldDropThreshold
#        Description: A recipe that drops from more creatures than this through a shared loot
#                     table is shown as a world drop (with a level range) instead of a list of
#                     creatures. Minimum 5.
#        Default:     25
#

RetailProfessions.WorldDropThreshold = 25

#
#    RetailProfessions.SaveZoneData
#        Description: Most creature and gameobject rows have no zoneId in the world database.
#                     At startup the module works zones out from the map files for the spawns it
#                     needs and, with 1, writes them back (creature.zoneId/areaId), so later
#                     starts are faster.
#        Default:     1
#

RetailProfessions.SaveZoneData = 1

#
#    RetailProfessions.Refine.Enable
#        Description: Milling and Prospecting from the profession window. The window lists the
#                     herbs or ore in a player's bags with what each one gives, and Mill All or
#                     Prospect All has the server work through them one cast at a time, with the
#                     same loot tables, skill requirement and five-per-cast as the spells, and
#                     put the results straight into the bags. Moving, fighting or closing the
#                     window stops it. Results that don't fit are mailed. With 0 the window has
#                     no Milling or Prospecting tab; the spells themselves always work.
#                     Turning it on needs a restart: the loot tables are read at startup.
#        Default:     1
#

RetailProfessions.Refine.Enable = 1

#
#    RetailProfessions.Refine.CastTime
#        Description: Milliseconds one cast takes when the server mills or prospects. 0 uses the
#                     spell's own cast time (Milling 51005, Prospecting 31252). At least 250.
#        Default:     0
#

RetailProfessions.Refine.CastTime = 0

#
#    RetailProfessions.Perks.Enable
#        Description: Retail's crafting stats, earned by skill instead of gear. A craft of a
#                     recipe can make a second batch (Multicraft, things that stack only), give
#                     part of its reagents back (Resourcefulness) and cast faster. Each is at
#                     its Min while the recipe is orange, rises in a straight line from where
#                     the recipe turns yellow to where it turns grey, and is at its Max from
#                     then on. Skill counts with its bonuses, as the profession window shows it.
#                     Three kinds of recipe only get the speed: the ones the core already rolls
#                     extra items for (skill_extra_item_template: most potions, elixirs, flasks
#                     and transmutes, whether or not the player has the mastery), recipes that
#                     can be crafted back into their own reagents (elemental, primal and eternal
#                     transmutes, prismatic shards) and recipes made only from what vendors
#                     sell without limit. Bots get the speed only.
#                     Which recipes get what is worked out at startup: turning this on, or a
#                     Max from 0 to something, needs a restart.
#        Default:     1
#

RetailProfessions.Perks.Enable = 1

#
#    RetailProfessions.Perks.Multicraft.Min
#    RetailProfessions.Perks.Multicraft.Max
#        Description: Chance in percent that a craft makes a second batch. Max 0 turns it off.
#                     A Min above 0 gives every recipe a base chance, also the ones at the top
#                     of an era's skill cap that never turn grey. A Min above its Max counts
#                     as the Max (the same goes for the two perks below).
#        Default:     0 / 25
#

RetailProfessions.Perks.Multicraft.Min = 0
RetailProfessions.Perks.Multicraft.Max = 25

#
#    RetailProfessions.Perks.Resourcefulness.Min
#    RetailProfessions.Perks.Resourcefulness.Max
#    RetailProfessions.Perks.Resourcefulness.Refund
#        Description: Chance in percent that a craft gives reagents back, and how much of each
#                     reagent a proc gives back, in percent. A fraction of a unit is a roll, so
#                     a proc gives back Refund percent on average and can give nothing on a
#                     recipe that uses one of each. Max 0 or Refund 0 turns it off.
#        Default:     0 / 20 / 30
#

RetailProfessions.Perks.Resourcefulness.Min = 0
RetailProfessions.Perks.Resourcefulness.Max = 20
RetailProfessions.Perks.Resourcefulness.Refund = 30

#
#    RetailProfessions.Perks.Speed.Min
#    RetailProfessions.Perks.Speed.Max
#        Description: How much shorter a craft's cast is, in percent (at most 90). A cast never
#                     goes under a quarter of a second, and one something else already changed
#                     (cooking with the Chef's Hat) is left alone. Max 0 turns it off.
#        Default:     0 / 50
#

RetailProfessions.Perks.Speed.Min = 0
RetailProfessions.Perks.Speed.Max = 50
